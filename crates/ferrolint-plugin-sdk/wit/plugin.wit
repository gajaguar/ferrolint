package ferrolint:plugin@1.2.0;

/// Data shared by the host and the plugin.
interface types {
    /// Diagnostic severity.
    enum severity {
        error,
        warning,
        info,
    }

    /// A point in the source: a byte offset, a 1-based line and a 1-based
    /// column counted in characters.
    record position {
        offset: u32,
        line: u32,
        column: u32,
    }

    /// A source range, start inclusive and end exclusive.
    record range {
        start: position,
        end: position,
    }

    /// A suggested edit: replace `range` with `replacement`. The host reports
    /// it; nothing on the plugin side applies it.
    record fix {
        description: string,
        replacement: string,
        range: range,
    }

    /// A diagnostic a plugin reports.
    record diagnostic {
        code: string,
        message: string,
        range: range,
        severity: severity,
        fix: option<fix>,
    }

    /// A rule a plugin can report, with the Pylint aliases it ports.
    record rule {
        code: string,
        name: string,
        summary: string,
        severity: severity,
        pylint-id: option<string>,
        pylint-symbol: option<string>,
    }

    /// What a plugin is and the rules it reports.
    record plugin-info {
        name: string,
        version: string,
        rules: list<rule>,
        /// Values the plugin adds to a host option, by option name:
        /// `good-names` gets `pk`, `qs` (1.1.0).
        contributions: list<tuple<string, list<string>>>,
        /// Whether `augment.suppress` has to be called (1.1.0).
        suppresses: bool,
        /// Whether `project.check-project` has to be called (1.1.0).
        checks-project: bool,
    }

    /// The file being linted.
    record file {
        /// The path as reports show it.
        path: string,
        /// The dotted module name derived from the path.
        module: string,
        /// The source text.
        source: string,
        /// The configuration's other options as written, sorted by key:
        /// `("max-args", "3")` for Pylint's `max-args=3`. A change to the
        /// record's shape: a host of 0.3.0 does not load a plugin built
        /// against 0.2.x.
        options: list<tuple<string, string>>,
    }

    /// The kind of an AST node.
    enum node-kind {
        module,
        // Statements.
        function-def,
        class-def,
        return,
        delete,
        assign,
        aug-assign,
        ann-assign,
        type-alias,
        for,
        while,
        if,
        %with,
        match,
        raise,
        try,
        assert,
        %import,
        import-from,
        global,
        nonlocal,
        expr,
        pass,
        break,
        continue,
        // Expressions.
        bool-op,
        named,
        bin-op,
        unary-op,
        lambda,
        if-exp,
        dict,
        set,
        list-comp,
        set-comp,
        dict-comp,
        generator,
        await,
        yield,
        yield-from,
        compare,
        call,
        f-string,
        t-string,
        string-literal,
        bytes-literal,
        number-literal,
        boolean-literal,
        none-literal,
        ellipsis-literal,
        attribute,
        subscript,
        starred,
        name,
        %list,
        %tuple,
        slice,
        // Other nodes.
        alias,
        arguments,
        keyword,
        parameters,
        parameter,
        decorator,
        except-handler,
        comprehension,
        with-item,
        elif-else-clause,
        match-case,
        pattern,
        type-param,
        /// A name in a `global` or `nonlocal` statement.
        identifier,
        other,
    }

    /// How an expression is used: read, bound or deleted.
    enum expr-context {
        none,
        load,
        store,
        del,
    }

    /// A file's AST, packed so it crosses into the plugin as two bulk
    /// copies. Nodes come in pre-order, the module first; a node's id is its
    /// position, and its descendants are exactly the ids after it up to its
    /// `last`. Each node takes fourteen words of `nodes`, in this order:
    ///
    /// 0. parent id + 1 (0 for the module)
    /// 1. kind: the index of its `node-kind` case
    /// 2-4. start offset, line and column
    /// 5-7. end offset, line and column
    /// 8. id of the last node of its subtree
    /// 9. expression context: the index of its `expr-context` case
    /// 10-11. start and end byte of its name in `strings`
    /// 12-13. start and end byte of its detail in `strings`
    ///
    /// An absent name or detail has start and end 4294967295. The name is
    /// what the node carries: a definition's name, a name's id, an
    /// attribute's attribute, an alias's dotted name, a keyword's argument,
    /// a parameter's name. The detail is an alias's `as` name, an
    /// `import-from`'s module (with its leading dots), an operator's
    /// spelling, or a number or boolean literal's source text.
    record ast {
        nodes: list<u32>,
        strings: string,
    }
}

/// Scope and binding queries the host answers about the current file.
interface semantic {
    use types.{range};

    enum scope-kind {
        module,
        class,
        function,
        lambda,
        comprehension,
        type-params,
    }

    record scope {
        id: u32,
        kind: scope-kind,
        /// The class or function name; none for the others.
        name: option<string>,
        /// The node that opens the scope.
        node: u32,
        parent: option<u32>,
    }

    enum binding-kind {
        assignment,
        annotation,
        %import,
        from-import,
        star-import,
        function-def,
        class-def,
        parameter,
        loop-var,
        with-item,
        except-handler,
        named-expr,
        comprehension-var,
        global,
        nonlocal,
        deletion,
        type-param,
        match-capture,
        builtin,
    }

    record binding {
        id: u32,
        name: string,
        kind: binding-kind,
        /// The scope the name lives in.
        scope: u32,
        /// The node that binds the name; none for a builtin.
        node: option<u32>,
        range: option<range>,
        /// For an import, what it binds: `os.path` for `import os.path as
        /// p`, `os.path.join` for `from os.path import join`.
        origin: option<string>,
    }

    /// The innermost scope holding `node`.
    scope-of: func(node: u32) -> scope;

    /// The bindings a name at `node` could see, one per name: shadowed
    /// bindings from outer scopes are left out, and so are builtins.
    visible-bindings: func(node: u32) -> list<binding>;

    /// The binding a `name` node (or a definition's name) resolves to;
    /// a builtin resolves to a `builtin` binding, an unknown name to none.
    resolve: func(node: u32) -> option<binding>;
}

/// Phase 2: what the host infers about the type of an expression. Best
/// effort: a plugin should stay silent on an unresolved answer. A host of
/// 0.2.1 still loads a plugin built against 0.2.0, which imports nothing
/// of this interface.
interface inference {
    /// Where an inferred type comes from.
    variant origin {
        /// A literal or display of the type: `1`, `"s"`, `[...]`, `x == y`.
        literal,
        /// A builtin, by name.
        builtin(string),
        /// An import, by what it imports: `os.path`, `os.path.join`.
        %import(string),
        /// A class definition, by its node.
        class-def(u32),
        /// A function definition, by its node.
        function-def(u32),
        /// What a call returns, by the call's node.
        call-return(u32),
        /// An annotation, by its node.
        annotation(u32),
        /// Nothing the engine could follow.
        unknown,
    }

    /// An inferred type.
    record inferred {
        /// The type: `int`, `str`, `type[Widget]` for the class itself,
        /// `Widget` for an instance, `module`, `function`; `unknown` when
        /// unresolved.
        name: string,
        origin: origin,
        /// False when the engine gave up on a dynamic pattern.
        resolved: bool,
    }

    /// The inferred type of the expression at `node`.
    infer: func(node: u32) -> inferred;
}

/// Comment ranges of the current file, for checkers that read comments
/// (markers, directives) rather than the AST. A host of 0.3.1 still loads
/// a plugin built against 0.3.0, which imports nothing of this interface.
interface comments {
    use types.{range};

    /// The ranges of the file's comments, in source order. Each starts at
    /// its `#` and ends before the line break; the text is
    /// `source[start.offset..end.offset]`.
    comment-ranges: func() -> list<range>;

    /// A comment with where it sits.
    record comment {
        range: range,
        /// True when only whitespace precedes the comment on its line.
        own-line: bool,
    }

    /// The file's comments, in source order, like `comment-ranges`.
    comment-list: func() -> list<comment>;
}

/// The options the configuration gives the calling plugin alone, unlike
/// the `options` of the `file` record, which every plugin receives.
interface settings {
    /// The pairs of the plugin's own `options` table in its `[[plugins]]`
    /// entry, sorted by key, as written; empty when it has none, and
    /// always empty for a bundled plugin.
    plugin-options: func() -> list<tuple<string, string>>;
}

/// What the host knows of the other files of the project. A host of 0.4.1
/// still loads a plugin built against 0.4.0, which imports nothing of it.
interface modules {
    /// The names the `from m import *` at the `alias` node binds, in the
    /// module's order. None when the host cannot tell: `m` is not a file
    /// under the project's directories (nor a C module it knows), or its
    /// source, or one it star-imports, does not parse. Like Pylint, it
    /// ignores the `__all__` of `m`.
    star-names: func(alias: u32) -> option<list<string>>;

    /// The names of the parameters of the method that the `function-def`
    /// node `method` overrides, position-only ones left out: the method of
    /// the same name in the first ancestor of the class that defines it, as
    /// Pylint's `overridden_method` finds it. None when `method` is not in
    /// a class, no ancestor defines it, or the host cannot tell: a base is
    /// not a class of the project, the standard library or the installed
    /// packages.
    overridden-parameters: func(method: u32) -> option<list<string>>;

    /// The names that the file's module-level `__all__` makes Pylint take
    /// for used: those of its first binding, when that is a list or a tuple
    /// of strings, also written `a + b`, `[*a]`, `list(a)`, as a name bound
    /// before, or as `m.__all__` of a module of the project. Empty when the
    /// file has none, or its value is not a list or a tuple for astroid
    /// (`sorted(...)`, a set). None when the host cannot tell.
    all-names: func() -> option<list<string>>;
}

/// Classes and ancestors, by qualified name (1.2.0). Only ferrolint's own
/// vocabulary crosses: no type of the type checker reaches a plugin, so an
/// upgrade of it may turn a `none` into an answer, never change this
/// interface. A plugin stays silent on `none`.
interface classes {
    variant class-ref {
        /// The expression is the class itself: `type[m.C]`.
        class(string),
        /// The expression is an instance of the class.
        instance(string),
    }

    /// The class the expression at `node` is, or is an instance of, by
    /// qualified name (`app.models.Device`). None when not one concrete class.
    class-of: func(node: u32) -> option<class-ref>;

    /// The MRO of a class, by qualified name, the class first. None when
    /// a base cannot be read.
    ancestors: func(class: string) -> option<list<string>>;

    /// The first class of the MRO of `class` whose body binds `member`.
    /// None when the MRO is unknown; some(none) when no class binds it.
    member-owner: func(class: string, member: string) -> option<option<string>>;
}

/// The plugin's exports.
interface checker {
    use types.{ast, diagnostic, file, plugin-info};

    /// The plugin's name, version and rules; called once per run.
    info: func() -> plugin-info;

    /// Check one file. Semantic queries made during the call are about
    /// this file.
    check: func(file: file, ast: ast) -> list<diagnostic>;
}

/// What a plugin changes in the host's own findings and settings (1.1.0).
interface augment {
    use types.{ast, diagnostic, file};

    /// The findings of the host's own rules in `file`, in the order the
    /// host gives them: the positions of those to drop. The plugin's
    /// findings never pass through it. `ast` is the file's, packed as
    /// `checker.check` gets it; the semantic queries answer nothing here.
    suppress: func(file: file, ast: ast, findings: list<diagnostic>) -> list<u32>;
}

/// A check over the files of the project together (1.1.0).
interface project {
    use types.{ast, diagnostic, file};

    /// Check all the files of the run at once, for a rule that compares
    /// them. Each file comes with its AST, packed as `checker.check` gets
    /// it; a file that does not parse is left out. Each finding comes with
    /// the `path` of the file it is about. The semantic queries answer
    /// nothing here: there is no current file.
    check-project: func(files: list<tuple<file, ast>>) -> list<tuple<string, diagnostic>>;
}

/// World contract for a ferrolint plugin.
world plugin {
    import semantic;
    import inference;
    import comments;
    import settings;
    import modules;
    import classes;
    export checker;
    export augment;
    export project;
}
